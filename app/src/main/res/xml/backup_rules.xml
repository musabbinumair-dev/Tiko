<?xml version="1.0" encoding="utf-8"?>
<!--
    android:allowBackup="false" is set in the manifest, so Auto Backup
    is disabled entirely. These rules are kept as an explicit safety net
    for devices that might still attempt a backup (e.g. vendor forks),
    and to satisfy lint checks that require a non-empty fullBackupContent.
    User data lives in Firestore; there is nothing to back up locally.
-->
<full-backup-content>
    <!-- Exclude Room database -->
    <exclude domain="database" path="tiko_tasks.db" />
    <exclude domain="database" path="tiko_tasks.db-shm" />
    <exclude domain="database" path="tiko_tasks.db-wal" />

    <!-- Exclude shared preferences that contain user data -->
    <exclude domain="sharedpref" path="tiko_settings_prefs.xml" />
</full-backup-content>
